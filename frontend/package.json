{
  "name": "osverse-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "pretest": "npm run audit:icons",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "audit:responsive": "node scripts/responsive-audit.mjs",
    "audit:icons": "node scripts/icon-audit.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
